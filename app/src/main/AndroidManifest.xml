<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NFC is required: the whole point of the app is reading a My Number Card. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <!-- No INTERNET permission, deliberately. DESIGN.md §2. -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <!--
             Rotation is handled in place rather than by recreating the activity.
             Reader mode is bound to this instance, so a recreation mid-signing
             tore the NFC link down under a card the user was holding to the
             phone, after a PIN attempt had already been spent. Compose reads the
             configuration reactively, so nothing here needs rebuilding for it.

             Deliberately not listing `locale` or `layoutDirection`: switching the
             app language relies on AppCompat recreating the activity.
        -->
        <!--
             singleTask, so a PDF shared in while the app is already running
             reaches onNewIntent instead of stacking a second MainActivity. With
             the default launch mode it did stack one, each with its own ViewModel
             and its own reader mode, and going back landed on a library that had
             never heard of the document just imported.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.JpkiSigner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Import path 1: the share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Import path 2: "Open with" from mail and file managers, which is
                 how a large share of PDFs actually arrive. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Persists the per-app language below API 33, where the platform has
             no LocaleManager. The service is never started; AppCompat only reads
             the meta-data. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- The card bring-up screen lives in src/debug and is declared there. -->
    </application>

</manifest>
