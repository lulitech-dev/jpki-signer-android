# Editor defaults for this repository. See https://editorconfig.org.
#
# Nothing enforces these — there is no formatter in the build. They exist so an
# editor shows the right ruler and does the right thing on save, which is what
# keeps the conventions below from drifting.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Prose is hard-wrapped at 80 columns, and the width is measured in *display
# columns*, not characters: the Japanese terms throughout these files are
# double-width, so a line of 78 characters can be 92 columns wide. Editors vary
# in which one they count, so the ruler is a guide rather than the rule.
#
# Hard-wrapped rather than one paragraph per line, because a paragraph here runs
# to 278 columns on average and 4294 at the longest. `git diff` and `git log -p`
# do not soft-wrap, so a one-word change to a paragraph-long line is unreadable
# in a terminal — which is the cost that buys the rewrapping this asks for.
[*.md]
max_line_length = 80

# 100 columns, from the Android Kotlin style guide -- Kotlin's own coding
# conventions name no number. A ruler rather than a rule -- it marks where a
# line starts being worth breaking. About thirty lines sit just past it, nearly
# all in tests, where wrapping an assertion or a long identifier would not make
# it clearer. Comments in these files are wrapped at 80 like the Markdown,
# because prose reads better narrow than code does.
[*.{kt,kts}]
max_line_length = 100

# Licence texts ship verbatim to discharge an attribution obligation, trailing
# whitespace included. Nothing here may rewrite them.
[app/src/main/res/raw/*.txt]
trim_trailing_whitespace = false
insert_final_newline = false

# A Windows batch file, generated by Gradle. CRLF is correct for it.
[gradlew.bat]
end_of_line = crlf
